# Copy this file to ".env" and fill in values as needed.
# NEVER commit the real ".env" to Git — it is excluded by .gitignore.

# --- Session security (optional, recommended) ---
# A fixed secret key keeps you logged in across container restarts.
# Generate one with:  openssl rand -hex 32
# Then uncomment the line below and paste the value.
# WEBUI_SECRET_KEY=

# --- Remote GPU inference (used in a later phase) ---
# When a remote GPU runs an OpenAI-compatible server (e.g. vLLM), point
# Open WebUI at it here, or configure it in the UI under
# Admin > Settings > Connections.
# OPENAI_API_BASE_URL=https://your-gpu-host:port/v1
# OPENAI_API_KEY=
